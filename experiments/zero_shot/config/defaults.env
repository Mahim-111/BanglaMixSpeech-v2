# Defaults used by run_zero_shot.sh. Environment variables override these.
MODELS="${MODELS:-mossformer2,convtasnet,dprnn,sepformer}"
SPEAKERS="${SPEAKERS:-2,3}"
SPLIT="${SPLIT:-test}"
VARIATION="${VARIATION:-all}"
METRICS="${METRICS:-full}"
EVALUATION_SR="${EVALUATION_SR:-reference}"
DEVICE="${DEVICE:-auto}"
BATCH_SIZE="${BATCH_SIZE:-0}"
MAX_ITEMS="${MAX_ITEMS:-}"
OUTPUT_ROOT="${OUTPUT_ROOT:-}"
CHECKPOINT_ROOT="${CHECKPOINT_ROOT:-}"
RUN_NAME="${RUN_NAME:-}"
